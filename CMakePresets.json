{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/build/${presetName}/bin",
                "CMAKE_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/build/${presetName}/lib",
                "CMAKE_ARCHIVE_OUTPUT_DIRECTORY": "${sourceDir}/build/${presetName}/lib",
                "CPM_SOURCE_CACHE": "${sourceDir}/build/cpm",
                "CONSOLPP_CCACHE": "ON",
                "CONSOLPP_NATIVE": "OFF",
                "CONSOLPP_SANITIZERS": "",
                "CONSOLPP_COVERAGE": "OFF",
                "CONSOLPP_CLANG_TIDY": "OFF",
                "CONSOLPP_FUZZ": "OFF"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "asan",
            "displayName": "Debug (AddressSanitizer + UndefinedBehaviorSanitizer)",
            "inherits": "debug",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CONSOLPP_SANITIZERS": "address;undefined"
            }
        },
        {
            "name": "ubsan",
            "displayName": "Debug (UndefinedBehaviorSanitizer)",
            "inherits": "debug",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CONSOLPP_SANITIZERS": "undefined"
            }
        },
        {
            "name": "tsan",
            "displayName": "Debug (ThreadSanitizer)",
            "inherits": "debug",
            "cacheVariables": {
                "CONSOLPP_SANITIZERS": "thread"
            }
        },
        {
            "name": "msan",
            "displayName": "Debug (MemorySanitizer)",
            "inherits": "debug",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CONSOLPP_SANITIZERS": "memory"
            }
        },
        {
            "name": "fuzz",
            "displayName": "Release with debug info (libFuzzer + AddressSanitizer + UndefinedBehaviorSanitizer)",
            "inherits": "relwithdebinfo",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CONSOLPP_SANITIZERS": "address;undefined",
                "CONSOLPP_FUZZ": "ON"
            }
        },
        {
            "name": "coverage",
            "displayName": "Debug (Coverage)",
            "inherits": "debug",
            "cacheVariables": {
                "CONSOLPP_COVERAGE": "ON"
            }
        },
        {
            "name": "tidy",
            "displayName": "Debug (clang-tidy)",
            "inherits": "debug",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CONSOLPP_CLANG_TIDY": "ON"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "release-native",
            "displayName": "Release (native CPU)",
            "inherits": "release",
            "cacheVariables": {
                "CONSOLPP_NATIVE": "ON"
            }
        },
        {
            "name": "relwithdebinfo",
            "displayName": "Release with debug info",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O3 -g -DNDEBUG"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "configurePreset": "debug"
        },
        {
            "name": "asan",
            "configurePreset": "asan"
        },
        {
            "name": "ubsan",
            "configurePreset": "ubsan"
        },
        {
            "name": "tsan",
            "configurePreset": "tsan"
        },
        {
            "name": "msan",
            "configurePreset": "msan",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "fuzz",
            "configurePreset": "fuzz",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "coverage",
            "configurePreset": "coverage"
        },
        {
            "name": "coverage-report",
            "configurePreset": "coverage",
            "targets": [
                "coverage-report"
            ]
        },
        {
            "name": "tidy",
            "configurePreset": "tidy"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "release-native",
            "configurePreset": "release-native"
        },
        {
            "name": "relwithdebinfo",
            "configurePreset": "relwithdebinfo"
        }
    ],
    "testPresets": [
        {
            "name": "test-base",
            "hidden": true,
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "debug",
            "inherits": "test-base",
            "configurePreset": "debug"
        },
        {
            "name": "asan",
            "inherits": "test-base",
            "configurePreset": "asan",
            "environment": {
                "ASAN_OPTIONS": "strict_string_checks=1:detect_stack_use_after_return=1:check_initialization_order=1:abort_on_error=1",
                "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
            }
        },
        {
            "name": "ubsan",
            "inherits": "test-base",
            "configurePreset": "ubsan",
            "environment": {
                "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
            }
        },
        {
            "name": "tsan",
            "inherits": "test-base",
            "configurePreset": "tsan",
            "environment": {
                "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1"
            }
        },
        {
            "name": "msan",
            "inherits": "test-base",
            "configurePreset": "msan",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "environment": {
                "MSAN_OPTIONS": "halt_on_error=1"
            }
        },
        {
            "name": "fuzz",
            "inherits": "test-base",
            "configurePreset": "fuzz",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "environment": {
                "ASAN_OPTIONS": "strict_string_checks=1:detect_stack_use_after_return=1:check_initialization_order=1:abort_on_error=1",
                "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
            }
        },
        {
            "name": "coverage",
            "inherits": "test-base",
            "configurePreset": "coverage"
        },
        {
            "name": "release",
            "inherits": "test-base",
            "configurePreset": "release"
        },
        {
            "name": "release-native",
            "inherits": "test-base",
            "configurePreset": "release-native"
        },
        {
            "name": "relwithdebinfo",
            "inherits": "test-base",
            "configurePreset": "relwithdebinfo"
        }
    ],
    "workflowPresets": [

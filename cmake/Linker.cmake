include(CheckLinkerFlag)

if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    check_linker_flag(CXX "-fuse-ld=mold" CONSOLPP_LINKER_MOLD)
    if(CONSOLPP_LINKER_MOLD)
        add_link_options(-fuse-ld=mold)
    else()
        check_linker_flag(CXX "-fuse-ld=lld" CONSOLPP_LINKER_LLD)
        if(NOT CONSOLPP_LINKER_LLD)
            message(FATAL_ERROR "Neither mold nor lld is usable as linker")
        endif()
        add_link_options(-fuse-ld=lld)
    endif()
endif()
